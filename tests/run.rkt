(check-equal? (frame-task-writes (task-by-id 'advance-progress)) '((316 4)))
(check-equal? (frame-task-writes (task-by-id 'hover-refresh-fps-button)) '((544 16)))
(check-equal? (frame-task-writes (task-by-id 'release-advance-progress-button)) '((616 8) (632 16)))

;; Action-Aware Tile Selection：所有 runtime task 的 tile 地址均由宏展开期固定。
(check-equal? (action-plan-tile-ids (find-action 'refresh-fps)) '(0))
(check-equal? (action-plan-tile-ids (find-action 'refresh-latency)) '(1))
(check-equal? (action-plan-tile-ids (find-action 'advance-progress)) '(2))
(check-equal? (for/list ([task (in-list schedule)])

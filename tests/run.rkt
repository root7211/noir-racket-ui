(check-equal? (hash-ref (entry-by-id 'tooltip-b) 'instance_offset) 396)
(check-equal? (hash-ref (entry-by-id 'tooltip-c) 'instance_offset) 440)
(check-equal? (hash-ref (entry-by-id 'advance-progress-button) 'instance_offset) 616)

;; Event/animation ABI 仍为稳定固定地址。
(define events (scene-event-map app-scene))

              '((release-refresh-fps-button (3))
                (release-refresh-latency-button (4))
                (release-advance-progress-button (5))
                (hover-refresh-fps-button (3))
                (hover-refresh-latency-button (4))
                (hover-advance-progress-button (5))
                (pressed-refresh-fps-button (3))
                (pressed-refresh-latency-button (4))
                (pressed-advance-progress-button (5))
                (refresh-fps (0))
                (refresh-latency (1))
                (advance-progress (2))))
